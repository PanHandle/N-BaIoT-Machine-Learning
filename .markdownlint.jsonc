{
	// So many problems with old and gold standard line_length of 80.
	// Originally to preserve screen-size, modern displays enable more
	// readable code, that said, I've kept most outputs in-line, but
	// Tables generated by pandas wisely ignore this rule.
	"MD013": {
		// Include code blocks
		"code_blocks": false,
		// Include tables
		"tables": false,
		// Include headings
		"headings": true,
		// Strict length checking
		"strict": false,
		// Stern length checking
		"stern": false
	}
}
